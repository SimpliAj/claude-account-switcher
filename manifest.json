{
    "manifest_version":  3,
    "name":  "Claude Account Switcher",
    "version":  "1.0.1",
    "description":  "Save and switch between multiple claude.ai logins with one click.",
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "action":  {
                   "default_popup":  "popup.html",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "permissions":  [
                        "cookies",
                        "storage",
                        "tabs"
                    ],
    "host_permissions":  [
                             "https://claude.ai/*",
                             "https://*.claude.ai/*"
                         ]
}